# Copy to .env.local for local development. Never commit real values.

# Canonical origin used for canonicals, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://telegen.ro

# Indexing switch. The site is noindex unless SITE_INDEXING=on AND VERCEL_ENV=production.
# Set only after the owner explicitly approves launch. Vercel sets VERCEL_ENV automatically.
SITE_INDEXING=off

# Launch-notification adapter ("prelaunch" fallback mode only): "disabled" (default) or "brevo".
NOTIFY_ADAPTER=disabled
BREVO_API_KEY=
BREVO_LIST_ID=

# Analytics provider. Empty = no analytics, no consent banner.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Sanity (Phase 5). Empty = typed local content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Search engine verification (rendered only when set AND VERCEL_ENV=production). See docs/LAUNCH.md.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Clinical area (CLAUDE.md v5). Local development and CI need none of these:
# without them, a local PGlite database, a test sign-in (code 123456, 2FA 654321),
# fake payments, file storage and an e-mail outbox are used. They run only off
# Vercel, and with `next start` only when CLINICAL_LOCAL=on (e2e sets it). See docs/SUPABASE.md.
CLINICAL_LOCAL=
DEV_SESSION_SECRET=
# Supabase (EU, Frankfurt). Either naming scheme works (src/lib/supabase-env.ts);
# the Vercel–Supabase integration's names are accepted too.
# URL: SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# Publishable key (sb_publishable_…). Also read: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy anon JWT).
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), server only. Also read: SUPABASE_SERVICE_ROLE_KEY (legacy).
# Never with a NEXT_PUBLIC_ prefix: the app refuses it.
SUPABASE_SECRET_KEY=
# Postgres connection string, Transaction pooler (port 6543). Needed: the clinical schema
# is reached only over Postgres with Row Level Security, never over the REST API.
# Also read: POSTGRES_URL (added by the Vercel–Supabase integration).
DATABASE_URL=
# on = apply supabase/migrations before each build. Off by default: migrations are applied
# from the Supabase SQL Editor (docs/supabase-setup.sql) or the owner's Claude chat.
DB_MIGRATE_ON_BUILD=
# Comma-separated e-mail addresses that become admins on first sign-in.
ADMIN_EMAILS=
# Stripe: test keys on previews, live keys in production (enforced).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Transactional e-mail (Brevo): BREVO_API_KEY (above) and the sender address (docs/EMAIL-AND-JOBS.md).
EMAIL_SENDER=
# Scheduled jobs (SLA reminders) call /api/cron/* with this secret.
CRON_SECRET=
# Invoicing (SmartBill or Oblio; docs/PHARMACY.md). Empty = invoices wait as "pending".
INVOICE_CIF=
INVOICE_SERIES=
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
OBLIO_EMAIL=
OBLIO_SECRET=
# Real patients are accepted only with APP_LAUNCH=on in production and the launch checks passing.
APP_LAUNCH=off

