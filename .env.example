# Copy to .env.local for local development. Never commit real values.

# Canonical origin used for canonicals, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://telegen.ro

# Indexing switch. The site is noindex unless SITE_INDEXING=on AND VERCEL_ENV=production.
# Set only after the owner explicitly approves launch. Vercel sets VERCEL_ENV automatically.
SITE_INDEXING=off

# Clinical app hand-over page (https). The evaluation POSTs only the chosen condition to it.
# Required to launch: a production build in the "open" state fails without it (docs/LAUNCH.md).
CLINICAL_APP_URL=

# Launch-notification adapter ("prelaunch" fallback mode only): "disabled" (default) or "brevo".
NOTIFY_ADAPTER=disabled
BREVO_API_KEY=
BREVO_LIST_ID=

# Analytics provider. Empty = no analytics, no consent banner.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Sanity (Phase 5). Empty = typed local content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Search engine verification (rendered only when set AND VERCEL_ENV=production). See docs/LAUNCH.md.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Clinical area (CLAUDE.md v5). Local development and CI need none of these:
# without them, a local PGlite database, development sign-in, fake payments and an
# e-mail outbox are used (never on Vercel). See docs/SUPABASE.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Transaction pooler URI (port 6543). The build applies supabase/migrations to it.
DATABASE_URL=
# Comma-separated e-mail addresses that become admins on first sign-in.
ADMIN_EMAILS=
# Stripe: test keys on previews, live keys in production (enforced).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Transactional e-mail (Brevo).
EMAIL_SENDER=
# Scheduled jobs (SLA reminders) call /api/cron/* with this secret.
CRON_SECRET=
# Real patients are accepted only with APP_LAUNCH=on in production and the launch checks passing.
APP_LAUNCH=off

